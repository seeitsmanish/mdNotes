// Ursa — see docs/TECH-SPEC.md §3 for the reasoning behind this shape.

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

// The connection URL lives in prisma.config.ts (Prisma 7 no longer accepts it
// here); the runtime client connects through the pg driver adapter.
datasource db {
  provider = "postgresql"
}

/// A note. `body` is the source of truth — raw markdown, exactly as typed.
/// `title` and `excerpt` are derived from it on every write so the note list
/// can be queried without shipping full bodies to the client.
///
/// There is no tag table: since v1.1 tags are styling, not filing, so nothing
/// about a note's organisation is derived from its text.
model Note {
  id        String    @id @default(cuid())
  body      String    @default("")
  title     String    @default("")
  excerpt   String    @default("")
  /// The first image in the body, shown as the list row's thumbnail (§4.51).
  cover     String?
  /// To-do counts for the list row's progress chip (§4.53).
  todoDone  Int       @default(0)
  todoTotal Int       @default(0)
  pinned    Boolean   @default(false)
  /// Out of the main list but kept and searchable (§4.65).
  archivedAt DateTime?
  /// A colour label for the row's dot and the colour filter (§4.65).
  color     String?
  /// A template: listed under Templates, used to start new notes (§4.65).
  isTemplate Boolean  @default(false)
  /// Locked behind the note passcode: no preview, body only after unlocking (§4.69).
  locked    Boolean   @default(false)
  /// Bumped on every body save; a save from an older version is refused and
  /// kept as a conflicted copy instead (PRD §4.18).
  version   Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  revisions NoteRevision[]
  share     NoteShare?

  @@index([deletedAt, pinned, updatedAt])
}

/// An earlier body of a note, kept so a bad edit can be undone after the
/// editor's own undo is gone (PRD §4.28). Deleting a note for good deletes its
/// history with it; moving it to the trash does not.
model NoteRevision {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([noteId, createdAt])
}

/// Appearance that should follow the user to any device (PRD R6.1).
///
/// One row, always id "singleton": there are no accounts, so a `userId` column
/// would hold one value forever. Device-specific settings — pane width, focus
/// mode, text size — deliberately stay in localStorage (R6.2).
model Settings {
  id            String   @id @default("singleton")
  theme         String   @default("forest")
  brandColor    String?
  radius        Float    @default(0.625)
  headingMode   String   @default("theme")
  editorWidth   String   @default("regular")
  editorPadding String   @default("medium")
  editorFont    String   @default("sans")
  /// Every session token carries the epoch it was issued under; raising it
  /// ends every session at once — "sign out everywhere" (PRD §4.30). Server
  /// only: never sent to the client with the appearance settings.
  sessionEpoch  Int      @default(0)
  /// scrypt hash of the note-lock passcode (§4.69). Server only.
  lockHash      String?
  updatedAt     DateTime @updatedAt
}

/// An image pasted or dropped into a note (PRD §4.24), served only to a
/// signed-in session from /api/attachments/:id. Notes refer to it by URL in
/// ordinary markdown, `![alt](/api/attachments/<id>)`, so the text stays the
/// source of truth and exports remain plain markdown.
///
/// No foreign key to Note: one image can appear in several notes, and a note
/// in the trash must still show its images if it is restored.
model Attachment {
  id        String   @id @default(cuid())
  /// Decided by the server from the file's magic bytes, never from the client.
  mime      String
  bytes     Bytes
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
}

/// One failed sign-in (PRD §4.33). Counted per client address over a sliding
/// window, in the database so every server instance sees the same count —
/// an in-memory counter reset on every cold start (security audit A7). Rows
/// older than a day are pruned on write.
model LoginFailure {
  id String   @id @default(cuid())
  ip String
  at DateTime @default(now())

  @@index([ip, at])
  @@index([at])
}

/// A public, read-only link to one note (§4.68). Deleting the row revokes it;
/// the token is 128 random bits, so links cannot be guessed.
model NoteShare {
  token     String   @id
  noteId    String   @unique
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

