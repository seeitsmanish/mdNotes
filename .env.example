# Matches docker-compose.yml. Copy to .env to get started.
DATABASE_URL="postgresql://ursa:ursa@localhost:5432/ursa?schema=public"

# The single password that opens the app. There are no accounts.
APP_PASSWORD="choose-a-long-password"

# Signs the session cookie. Must be at least 32 characters.
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-me"
